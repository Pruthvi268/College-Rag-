# CollegeRAG Environment Configuration

# Application
PROJECT_NAME=CollegeRAG
API_V1_STR=/api
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security
SECRET_KEY=collegerag_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: local SQLite database, change to postgresql+asyncpg://... for PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./collegerag.db

# Vector Database (Qdrant)
# Leave QDRANT_URL empty to use local persistent embedded Qdrant store (./qdrant_storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=college_knowledge_base

# Google Gemini API
# If GEMINI_API_KEY is not set or invalid, system runs in smart simulation/local embedding fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# RAG Configuration
SIMILARITY_THRESHOLD=0.35
TOP_K_RETRIEVAL=5
CHUNK_SIZE=600
CHUNK_OVERLAP=80
MAX_HISTORY_MESSAGES=6
